# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Videos are not shipped: they blow past Vercel’s ~300MB serverless bundle limit for /api/memories
# (Next traces public/memories into that function). Keep clips locally or host on YouTube/Drive.
/public/memories/**/*.mp4
/public/memories/**/*.mov
/public/memories/**/*.webm
/public/memories/**/*.m4v
