# Used only by: npm run sync:memories
# (The live site does not read these — it uses committed files under data/ and public/memories/.)

# Optional: override the Google Sheet CSV export URL
# GOOGLE_SHEET_CSV_URL=https://docs.google.com/spreadsheets/d/.../export?format=csv&gid=...

# If set, sync downloads images into public/memories/
DROPBOX_ACCESS_TOKEN=

# Optional: shared folder link (defaults to the project album if unset)
# DROPBOX_SHARED_FOLDER_URL=https://www.dropbox.com/scl/fo/...
