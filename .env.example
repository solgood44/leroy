# Optional: override the public Google Sheet CSV export URL
# GOOGLE_SHEET_CSV_URL=https://docs.google.com/spreadsheets/d/.../export?format=csv&gid=...

# Required for Dropbox photos: create an app at https://www.dropbox.com/developers/apps
# Enable scopes: files.metadata.read, files.content.read
# Then generate an access token for your account (see README).
DROPBOX_ACCESS_TOKEN=

# Optional: shared folder link (defaults to the project’s album if unset)
# DROPBOX_SHARED_FOLDER_URL=https://www.dropbox.com/scl/fo/...
